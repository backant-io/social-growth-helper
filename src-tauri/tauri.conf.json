{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Social Growth Helper",
  "version": "0.1.0",
  "identifier": "io.backant.social-growth-helper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Social Growth Helper",
        "width": 1100,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first X growth copilot",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libsecret-1-0", "gnome-keyring | keepassxc | kwalletmanager"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libsecret", "gnome-keyring"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
